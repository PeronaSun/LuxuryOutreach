{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 300,
      "includeFiles": "docs/brand-bible-v1.txt",
      "excludeFiles": "{runtime,evaluation,deliverables,tests,public,dist}/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?__route=:path*" }
  ]
}
