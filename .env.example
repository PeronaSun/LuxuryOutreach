# Local demo only. On Vercel set DEMO_MODE=false and configure the three DeepSeek variables.
# All credentials are server-only. Never use VITE_ for secrets.
DEMO_MODE=true
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
PORT=3001

# Optional durable shared Journal (Upstash Redis REST). Keep both values server-side.
# Without Redis, Vercel uses temporary /tmp records that may disappear at any time.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# JOURNAL_REDIS_KEY=maison-liore:production:records
